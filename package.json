{
  "name": "3d-bair-songolt",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node tools/start.mjs",
    "sync": "node tools/sync.mjs",
    "sync:watch": "node tools/sync.mjs watch",
    "sync:list": "node tools/sync.mjs list",
    "sync:undo": "node tools/sync.mjs undo",
    "sync:back": "node tools/sync.mjs back",
    "sync:install": "node tools/sync.mjs install",
    "dev": "pnpm --filter @bair/showroom dev",
    "dev:website": "pnpm --filter @bair/website dev",
    "build": "pnpm -r build && node tools/assemble-pages.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx,css}\" \"packages/**/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
